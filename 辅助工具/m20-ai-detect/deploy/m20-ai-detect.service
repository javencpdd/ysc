[Unit]
Description=m20-ai-detect: M20 Pro video -> AI detection sampler
Documentation=file:/home/djw/m20-ai-detect/README.md
# 只在网络就绪后启动；不依赖机器人任何服务（AOS 挂了只是没帧，不应拖累本机）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# GOS 无 djw 系统账户；登录账户是 user（uid 1003，sudo 组）。
# /home/djw 是 root 所有的目录，已设 ACL 授权 user:user:rwx（含 default ACL），
# 故工作空间按用户决策仍放 /home/djw/m20-ai-detect，服务以 user 运行。
User=user
Group=user
WorkingDirectory=/home/djw/m20-ai-detect
EnvironmentFile=/home/djw/m20-ai-detect/m20-ai-detect.env
Environment=PYTHONPATH=/home/djw/m20-ai-detect/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m m20_ai_detect run
Restart=always
RestartSec=5
# GOS 隔离了 4 个 A76 大核给厂商关键任务，普通负载只用小核 0-3
CPUAffinity=0-3
# 资源上限：采样器本身很轻（ffmpeg 抽帧 + 每帧一次 HTTP），给 1G 足够
MemoryMax=1G
Nice=5
# 日志：stdout 走 journal，另由 logrotate 管文件日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=m20-ai-detect

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
# 唯一需要写的目录：工作空间自身
ReadWritePaths=/home/djw/m20-ai-detect
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
