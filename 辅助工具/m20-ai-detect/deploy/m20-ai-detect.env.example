# ============================================================
# m20-ai-detect 生产配置模板（GOS 10.21.31.104 专用）
# 用法：cp deploy/m20-ai-detect.env.example m20-ai-detect.env 后按需修改
# 约束：本文件允许入库（不含密钥）；带凭据的 AI_BASE 请写在 m20-ai-detect.env（已 gitignore）
# ============================================================

# ---------- AI 识别服务 ----------
M20AI_AI_BASE=http://jsxy.aihyzh.com:30881
M20AI_CAP_ID=ai-04-yolov8-object-detection
# 注意单引号：bash source / systemd EnvironmentFile 都会做引号剥除，
# 不包起来内层双引号会被吃掉，JSON 即非法（2026-10-15 踩过）
M20AI_PARAMS_JSON='{"obj_thresh":0.3,"nms_thresh":0.45}'
M20AI_TIMEOUT=10
M20AI_RETRY_BASE=1
M20AI_RETRY_MAX=30

# ---------- 部署位：GOS（默认） ----------
# GOS 与 AOS 同内网（10.21.31.0/24），直达相机流，不占用 AOS 算力
#
# 以下 ENABLE_F/_B + SRC_F/_B 是旧两槽位写法，仍然有效；
# 新写法 M20AI_SOURCES 支持任意 N 路与多类型，**设了它就以它为准**
# （旧键被忽略但保留在文件里）。控制台「视频源与采集」卡即读写该键。
M20AI_ENABLE_F=1
M20AI_SRC_F=rtsp://10.21.31.103:8554/video1
M20AI_CAM_NAME_F=front
M20AI_ENABLE_B=0
M20AI_SRC_B=rtsp://10.21.31.103:8554/video2
M20AI_CAM_NAME_B=back

# ---------- 视频源（ADR-016；设了即覆盖上面的旧两槽位） ----------
# 单行语法：name=类型://地址[|选项]，源之间用 ; 分隔（不是逗号——URL/extra 里可能含逗号）
#   选项：transport=tcp|udp|auto（rtsp 用，默认 tcp 优先）、fps=逐路覆盖全局、
#        extra=逗号分隔的 ffmpeg 片段、note=备注、off=停用但保留配置
# 类型：rtsp / rtmp / http(MJPEG) / device(本地相机) / file(回放) / onvif(待握手)
# 例：M20AI_SOURCES='front=rtsp://10.21.31.103:8554/video1;gate=rtmp://192.168.2.1:1935/live/0|fps=2'
# 本地相机（device:///dev/video0）展开出的命令行含上游禁词 v4l2，会被 restart.sh 误杀；
# 确认本机不触发该脚本后，显式放行（控制台新增 device:// 源时会拦下并提示）：
# M20AI_ALLOW_LOCAL_DEVICE=1

# ---------- 采集 ----------
M20AI_FPS=1
M20AI_JPEG_Q=3
M20AI_FRESH_AGE_SEC=0.8
M20AI_FFMPEG_BIN=ffmpeg
M20AI_FFMPEG_EXTRA=

# ---------- 存储 ----------
# 注意：systemd unit 的 ReadWritePaths 同步指向这里，改路径必须改 unit
#
# ⚠️ 单位写法（ADR-010）：以下 4 个数值字段**带不带单位都行**——
#   体积类（*_MB）：裸数字按 MB；也可写 500M / 1G / 512K（K/M/G/T，不分大小写）
#   时长类（*_DAYS）：裸数字按**天**；也可写 7d / 24h / 30m / 2w（s/m/h/d/w）
#   非法单位会明确报错（控制台保存时即拦下）；例：SAVED_MAX_MB=1G 等价于 1024。
M20AI_BASE_DIR=/home/djw/m20-ai-detect
# raw/ 环形缓冲上限（MB，默认 200，最小 10）：超配额删最旧帧（空间不足，控制台留存卡）。
M20AI_RING_MAX_MB=200
# spool/ 积压上限（帧数，默认 600）：AI 服务长时间不可用时抽帧仍在继续，
# 超限丢最旧帧，避免把磁盘写满（2 路 1fps 时约 7MB/分钟）。
M20AI_SPOOL_MAX_FILES=600
# 旧开关：true 等价于 SAVE_MODE=alert（兼容保留，新部署用下面的 SAVE_MODE）
M20AI_SAVE_RESULT_IMAGE=false

# ---------- 响应留存（ADR-006 / ADR-008 / ADR-011） ----------
# 触发条件：off=只写 JSONL（默认）；alert=命中「关注目标」（见下方 ALERT_*）；any=检出任意目标；all=每帧
# alert 模式即"只保存检测到指定目标的图片"：清单在网页「关注目标」卡可点选（今日检出标签一键加入），
#   清单为空 = 一帧都不保存；想"只存有人的图"就设 ALERT_LABELS=person + SAVE_MODE=alert。
# 触发时成对落 saved/<cam>/<帧名>.jpg（AI 标注结果图，实测 ~85KB）
#   + 同名 .json（原始响应，已剥离占体积 94% 的 base64 图字段，改留 jpg 路径引用）
# JSONL 记录同步写 saved_image / resp_path 两个字段；控制台「最近检测」可点开看原始响应；
# 网页「目标图片时间轴」卡片按 _saved_at（真实时钟）滑动浏览 saved/ 里的图片。
# 磁盘参考（1 路 1fps，实测单对 ≈0.1MB：结果图 ~85KB + 响应 ~2KB）：
#   any ≈7GB/天量级（本机实测检出率 ~96%，几乎逐帧）、all 略高、alert ≈0.3GB/天量级（视关注目标命中率）。
#   上限、磁盘占用、可回看窗口三者联动——务必按实测定 SAVED_MAX_MB。
M20AI_SAVE_MODE=off
# saved/ 留存清理（ADR-008）：采样器每 10 分钟检查一次，从最旧的成对文件开始删。
# SAVED_MAX_MB：总量上限（MB，默认 500），0 = 不按体积清理；any 模式 ≈ 最近 1~2 小时、alert ≈ 1~2 天。
# SAVED_KEEP_DAYS：保留天数（默认 0 = 不按年龄清理）；>0 时先按年龄删再按体积删。
# 两者都支持带单位写法（见上方"单位写法"说明），如 SAVED_MAX_MB=1G、SAVED_KEEP_DAYS=24h。
M20AI_SAVED_MAX_MB=500
M20AI_SAVED_KEEP_DAYS=0
# results/ JSONL 保留天数（默认 0 = 永不删；权威数据，建议保持 0）。
M20AI_RESULTS_KEEP_DAYS=0

# ---------- 关注目标（ADR-011；即告警清单 + alert 留存过滤） ----------
# 命中任一标签（且 score ≥ ALERT_SCORE）的帧：① 计入「告警次数」；② SAVE_MODE=alert 时保存图片。
# 标签为模型的英文类名（COCO/YOLO 标签集），逗号分隔；留空 = 不告警、alert 模式不保存。
# 网页「关注目标」卡可直接编辑，并显示"今日检出标签"点选；改动保存后（采集运行中会重启生效）。
M20AI_ALERT_LABELS=person,fire,smoke
M20AI_ALERT_SCORE=0.60

# ---------- 心跳 ----------
M20AI_SOURCE_DOWN_SEC=30

# ---------- 时钟（ADR-004） ----------
# M20 车队 PTP 主时钟把本机系统时间钉在 2024-06-20（phc2sys 持续拖回），
# 不跟车队较劲：保持车队时间基准，采样器启动时向 AI 服务 Date 头自动测量
# 偏移量，把 JSONL 的 ts 修正为真实时间（ts_host 保留本机原值）。
# 0 = 启动时自动测量（默认，推荐）；非 0 = 手动钉值，doctor 在实测偏差 >2s 时告警。
M20AI_TS_OFFSET_SEC=0
