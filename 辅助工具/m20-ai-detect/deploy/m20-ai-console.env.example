# ============================================================
# m20-ai-console 控制台自身配置（systemd EnvironmentFile 注入）
# 用法：cp deploy/m20-ai-console.env.example m20-ai-console.env 后按需修改
# 本文件可入库（不含密钥）；采样器配置在 m20-ai-detect.env，别混淆
# ============================================================

# 监听地址与端口（用户决策：默认开放 5050；0.0.0.0 = 机器人内网可达，
# AOS 无入站 DNAT，外网到不了；需要更收紧可改 10.21.31.104 或 127.0.0.1）
M20AIC_BIND=0.0.0.0
M20AIC_PORT=5050

# 访问 token：留空 = 内网开放；设置后所有 /api/* 需要 X-Console-Token 头或 ?token=
M20AIC_TOKEN=

# 工作空间与受控对象（一般不用改）
M20AIC_BASE_DIR=/home/djw/m20-ai-detect
M20AIC_ENV_FILE=/home/djw/m20-ai-detect/m20-ai-detect.env
M20AIC_HELPER=/usr/local/sbin/m20-ai-console-helper
