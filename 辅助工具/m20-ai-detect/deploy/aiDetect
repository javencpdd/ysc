#!/usr/bin/env bash
# ============================================================
# aiDetect —— 本项目的终端运维命令（参考部署：GOS 10.21.31.104，以业务账户执行）
#
# 提权模型（与 ADR-005 / ADR-007 一致）：
#   * 服务动作（启停/重启/开机自启开关）一律经 sudoers 精确白名单调 root helper
#     （NOPASSWD、无自由参数），本脚本不引入任何其它提权路径；
#   * 清 spool/ 积压帧不提权——文件归 user（与网页端「清理数据」勾 spool 同款操作）；
#   * reset = 停采集（仅运行中）→ 删 spool/*.jpg → 恢复采集原状态（ADR-011）。
#
# 装入（console-bootstrap.sh 会自动执行；手动亦可）：
#   sudo install -m 755 deploy/aiDetect /usr/local/bin/aiDetect
#   sudo ln -sf /usr/local/bin/aiDetect /usr/local/bin/aidetect
# ============================================================
set -euo pipefail

ENV_FILE_DEFAULT=/home/djw/m20-ai-detect/m20-ai-detect.env
BASE="${M20AI_BASE_DIR:-}"
if [[ -z "$BASE" && -f "$ENV_FILE_DEFAULT" ]]; then
  BASE="$(sed -n 's/^M20AI_BASE_DIR=//p' "$ENV_FILE_DEFAULT" | head -1 | tr -d '"' || true)"
fi
BASE="${BASE:-/home/djw/m20-ai-detect}"

# ---- 身份解析（ADR-017）------------------------------------------------------
# 单元名 / env 名 / helper 名 / sudoers 名全部由 app_id 派生。缺省值先按
# 老部署（m20）摆好；$BASE/deploy/identity.sh 存在时用它反查真实身份
# （env 文件内的 M20AI_APP_ID > 文件名前缀 > 缺省 m20）。老机器的代码里
# 没有这个文件 → 走缺省分支，行为与改造前逐字一致。
APP_ID=m20
ENV_FILE="$BASE/m20-ai-detect.env"
CONSOLE_ENV_FILE="$BASE/m20-ai-console.env"
HELPER="/usr/local/sbin/m20-ai-console-helper"
SUDOERS="/etc/sudoers.d/m20-ai-console"
SAMPLER=m20-ai-detect
CONSOLE=m20-ai-console
if [[ -f "$BASE/deploy/identity.sh" ]]; then
  # shellcheck source=deploy/identity.sh
  . "$BASE/deploy/identity.sh"
  detect_identity "$BASE" 2>/dev/null || true
  SAMPLER="$UNIT_NAME"
  CONSOLE="$CONSOLE_UNIT_NAME"
fi
# 手工逃生门：多身份同机/调试时显式指定（优先级高于反查结果）
ENV_FILE="${M20AI_ENV_FILE:-$ENV_FILE}"
HELPER="${M20AI_HELPER:-$HELPER}"

if [[ -z "$BASE" || "$BASE" == "/" ]]; then
  echo "aiDetect: BASE 非法：'$BASE'" >&2
  exit 1
fi

die() { printf 'aiDetect: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- 基础件
state_of() { systemctl is-active "$1" 2>/dev/null || true; }
enabled_of() { local s; s="$(systemctl is-enabled "$1" 2>/dev/null || true)"; printf '%s' "${s:-unknown}"; }
pid_of()   { systemctl show "$1" -p MainPID --value 2>/dev/null || true; }
since_of() {
  local s
  s="$(systemctl show "$1" -p ActiveEnterTimestamp --value 2>/dev/null || true)"
  printf '%s' "$s" | sed -E 's/^[A-Za-z]{3} //'
}

helper() { sudo -n "$HELPER" "$@"; }

svc_action() {  # $1=sampler|console  $2=start|stop|restart|enable|disable
  local target="$1" verb="$2" sub
  if [[ "$target" == "console" ]]; then sub="console-$verb"; else sub="svc-$verb"; fi
  helper "$sub"
}

act_hint() {  # $1=unit  $2=动作描述（服务动作失败时的可操作提示）
  die "「$2」失败。检查：① $SUDOERS 白名单是否含对应子命令（重跑 deploy/console-bootstrap.sh）；② journalctl -u $1 -n 20"
}

report_svc() {  # $1=unit  $2=标签
  local st
  st="$(state_of "$1")"
  printf '  %s  %s' "$2" "$st"
  if [[ "$st" == "active" ]]; then
    printf '  PID %s  since %s' "$(pid_of "$1")" "$(since_of "$1")"
  fi
  echo
}

last_record() {  # 今日 JSONL 最后一条，格式化一行；无记录/解析失败返回非 0
  local f="$BASE/results/$(date +%Y%m%d).jsonl"
  [[ -f "$f" ]] || return 1
  tail -n 1 "$f" | python3 -c '
import json, sys

def fmt(it):
    try:
        s = "%.2f" % float(it.get("score") or 0)
    except Exception:
        s = "-"
    return "%s %s" % (it.get("label", "?"), s)

try:
    r = json.loads(sys.stdin.read() or "{}")
except Exception:
    sys.exit(1)
items = r.get("items") or []
top = "，".join(fmt(i) for i in items[:3])
flags = []
if r.get("alert"):
    flags.append("ALERT")
if r.get("saved_image") or r.get("resp_path"):
    flags.append("已留存")
print("  %s  cam=%s  检出 %s 个%s%s" % (
    r.get("ts", "-"), r.get("cam", "-"), r.get("n_items", len(items)),
    ("：" + top) if top else "",
    ("  [" + "/".join(flags) + "]") if flags else "",
))
' 2>/dev/null
}

# ---------------------------------------------------------------- 子命令
# 启动行为（ADR-010）：up/down/restart/enable/disable 只作用于**控制台**；
# 采集（采样器抽帧并调 AI）默认关闭，由「控制台网页采集开关」或 `aiDetect collect on|off` 控制。

collect_hint() {  # 采集当前状态一行提示
  if [[ "$(state_of "$SAMPLER")" == "active" ]]; then
    echo "采集：运行中（采样器 PID $(pid_of "$SAMPLER")）"
  else
    echo "采集：已关闭（默认）。开启：控制台网页「采集开关」或 aiDetect collect on"
  fi
}

cmd_up() {
  [[ $# -eq 0 ]] || die "up 不接受参数（要开采集：aiDetect collect on）"
  if [[ "$(state_of "$CONSOLE")" == "active" ]]; then
    echo "控制台 $CONSOLE 已是 active（PID $(pid_of "$CONSOLE")），无需操作"
  else
    echo "启动控制台 $CONSOLE …"
    svc_action console start || act_hint "$CONSOLE" "启动控制台"
    sleep 1
    echo "  → $(state_of "$CONSOLE")（PID $(pid_of "$CONSOLE")）"
  fi
  collect_hint
}

cmd_down() {
  [[ $# -eq 0 ]] || die "down 不接受参数（要停采集：aiDetect collect off）"
  if [[ "$(state_of "$CONSOLE")" != "active" ]]; then
    echo "控制台 $CONSOLE 已是 inactive，无需操作"
  else
    echo "停止控制台 $CONSOLE …"
    svc_action console stop || act_hint "$CONSOLE" "停止控制台"
    echo "  → $(state_of "$CONSOLE")"
  fi
  if [[ "$(state_of "$SAMPLER")" == "active" ]]; then
    echo "提示：采集仍在运行（不受影响）。停止采集：aiDetect collect off"
  fi
}

cmd_restart() {
  [[ $# -eq 0 ]] || die "restart 不接受参数（要重启采样器：aiDetect collect restart）"
  echo "重启控制台 $CONSOLE …"
  svc_action console restart || act_hint "$CONSOLE" "重启控制台"
  sleep 1
  echo "  → $(state_of "$CONSOLE")（PID $(pid_of "$CONSOLE")）"
  echo "提示：改过 env 后要重启的是采样器：aiDetect collect restart"
}

cmd_collect() {  # $1=on|off|restart|status
  [[ $# -le 1 ]] || die "collect 只接受一个参数（用法：aiDetect collect on|off|restart|status）"
  local a="${1:-status}"
  case "$a" in
    on)
      if [[ "$(state_of "$SAMPLER")" == "active" ]]; then
        echo "采集已是运行中（采样器 PID $(pid_of "$SAMPLER")），无需操作"
      else
        echo "开启采集（启动采样器 $SAMPLER）…"
        svc_action sampler start || act_hint "$SAMPLER" "启动采样器"
        sleep 1
        echo "  → $(state_of "$SAMPLER")（PID $(pid_of "$SAMPLER")）"
      fi
      ;;
    off)
      if [[ "$(state_of "$SAMPLER")" != "active" ]]; then
        echo "采集已是关闭状态，无需操作"
      else
        echo "关闭采集（停止采样器 $SAMPLER）…"
        svc_action sampler stop || act_hint "$SAMPLER" "停止采样器"
        echo "  → $(state_of "$SAMPLER")"
      fi
      echo "提示：控制台网页仍可访问（历史数据/时间轴/文件浏览不受影响）"
      ;;
    restart)
      echo "重启采样器 $SAMPLER …"
      svc_action sampler restart || act_hint "$SAMPLER" "重启采样器"
      sleep 1
      echo "  → $(state_of "$SAMPLER")（PID $(pid_of "$SAMPLER")）"
      ;;
    status)
      if [[ "$(state_of "$SAMPLER")" == "active" ]]; then
        echo "采集：运行中（采样器 PID $(pid_of "$SAMPLER")，since $(since_of "$SAMPLER")）"
      else
        echo "采集：已关闭（默认）"
      fi
      ;;
    *) die "collect 未知参数：$a（用法：aiDetect collect on|off|restart|status）" ;;
  esac
}

cmd_autostart() {  # $1=enable|disable —— 只作用于控制台（采集自启默认且保持关闭）
  local verb="$1"
  local word want_state cur
  if [[ "$verb" == "enable" ]]; then word="开启"; want_state="enabled"; else word="关闭"; want_state="disabled"; fi
  echo "aiDetect $verb —— ${word}控制台开机自启（systemctl $verb；不影响当前运行/停止状态）"
  cur="$(enabled_of "$CONSOLE")"
  if [[ "$cur" == "$want_state" ]]; then
    echo "  控制台 $CONSOLE：已是 $cur，无需操作"
  else
    echo "  控制台 $CONSOLE：$cur → $want_state …"
    svc_action console "$verb" || act_hint "$CONSOLE" "${word}开机自启"
    echo "    → $(enabled_of "$CONSOLE")"
  fi
  echo "说明：采集（采样器）不设开机自启——重启后默认关闭，按需在控制台网页或 aiDetect collect on 开启。"
}

cmd_reset() {
  [[ $# -eq 0 ]] || die "reset 不接受参数（用法：aiDetect reset）"
  [[ -d "$BASE/spool" ]] || die "找不到 $BASE/spool（BASE 是否正确？）"
  echo "aiDetect reset —— 清空积压帧，以实时为准（只动 spool/）"

  # ADR-011：清空类操作不改变采集开关状态——仅在运行时停、清完恢复；原本关着不拉起
  local was_active=0
  [[ "$(state_of "$SAMPLER")" == "active" ]] && was_active=1

  if [[ "$was_active" == "1" ]]; then
    echo "  [1/3] 停止采集器 $SAMPLER …"
    if ! svc_action sampler stop; then
      die "停采集器失败，未清空任何帧（检查 sudoers 白名单：重跑 deploy/console-bootstrap.sh）"
    fi
  else
    echo "  [1/3] 采集未运行，跳过停止步骤（清完也不会启动）"
  fi

  echo "  [2/3] 清空 spool/ 待推理帧 …"
  local frames bytes mb left
  frames="$(find "$BASE/spool" -name '*.jpg' -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
  bytes="$(find "$BASE/spool" -name '*.jpg' -type f -printf '%s\n' 2>/dev/null | awk '{s+=$1} END{print s+0}' || true)"
  find "$BASE/spool" -name '*.jpg' -type f -delete 2>/dev/null || echo "        警告：部分帧删除失败"
  mb="$(awk -v b="$bytes" 'BEGIN{printf "%.1f", b/1048576}')"
  left="$(find "$BASE/spool" -name '*.jpg' -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
  if [[ "$left" != "0" && -n "$left" ]]; then
    echo "        已删 $frames 帧（$mb MB），仍剩 $left 帧（删除失败？）"
  else
    echo "        已删 $frames 帧（$mb MB）"
  fi

  if [[ "$was_active" == "1" ]]; then
    echo "  [3/3] 恢复启动采集器 $SAMPLER …"
    if ! svc_action sampler start; then
      die "清空已完成，但重启采集器失败！手动检查：journalctl -u $SAMPLER -n 30"
    fi
    sleep 1
    echo "  → $(state_of "$SAMPLER")（PID $(pid_of "$SAMPLER")）"
    echo "完成：之后按实时 1 fps 消费；raw/ 环形缓冲与 results/ 记录未动。"
  else
    echo "  [3/3] 采集原本未运行，保持关闭（要开始采集：aiDetect collect on）"
    echo "完成：spool/ 已清空；raw/ 环形缓冲与 results/ 记录未动。"
  fi
}

cmd_status() {
  [[ $# -eq 0 ]] || die "status 不接受参数"
  local nframes oldest age_min f nrec nsaved port ip

  echo "M20 AI 检测 —— 状态总览"
  echo "  主机 $(hostname 2>/dev/null || echo '?')    工程 $BASE"
  echo

  echo "服务"
  report_svc "$CONSOLE" "控制台"
  report_svc "$SAMPLER" "采集器"
  echo "        采集开关  $(if [[ "$(state_of "$SAMPLER")" == "active" ]]; then echo 运行中; else echo 已关闭（默认）; fi)（切换：aiDetect collect on|off 或控制台网页）"
  echo "        开机自启 控制台 $(enabled_of "$CONSOLE") · 采集器不设自启（手动启动：aiDetect up）"
  ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  port="$(sed -n 's/^M20AIC_PORT=//p' "$CONSOLE_ENV_FILE" 2>/dev/null | head -1 || true)"
  port="${port:-5050}"
  if [[ -n "${ip:-}" ]]; then
    echo "        控制台地址 http://$ip:$port（机器人内网）"
  fi
  echo

  echo "版本"
  if PYTHONPATH="$BASE/src:$BASE" python3 -c 'import m20_ai_detect, webconsole' 2>/dev/null; then
    PYTHONPATH="$BASE/src:$BASE" python3 -c 'import m20_ai_detect, webconsole; print("  采样器 v%s / 控制台 v%s" % (m20_ai_detect.__version__, webconsole.__version__))' \
      || echo "  （版本读取失败）"
  else
    echo "  （python 导入失败，检查 $BASE/src 与 $BASE/webconsole）"
  fi
  echo

  echo "积压与存储"
  nframes="$(find "$BASE/spool" -name '*.jpg' -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
  if [[ "$nframes" -gt 0 ]]; then
    oldest="$(find "$BASE/spool" -name '*.jpg' -type f -printf '%T@\n' 2>/dev/null | sort -n | head -1 || true)"
    if [[ -n "$oldest" ]]; then
      age_min="$(awk -v a="$oldest" -v n="$(date +%s)" 'BEGIN{printf "%.1f", (n-a)/60}')"
    else
      age_min="?"
    fi
    echo "  spool/ 待推理   $nframes 帧（最早 $age_min 分钟前）"
  else
    echo "  spool/ 待推理   0 帧（实时跟上，无积压）"
  fi
  f="$BASE/results/$(date +%Y%m%d).jsonl"
  nrec=0
  if [[ -f "$f" ]]; then
    nrec="$(wc -l < "$f" | tr -d ' ' || true)"
  fi
  echo "  results/ 今日   $nrec 条检测记录"
  nsaved="$(find "$BASE/saved" -name '*.json' -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
  echo "  saved/ 留存     $nsaved 对（图+响应）"
  df -h --output=target,pcent,avail "$BASE" 2>/dev/null | awk 'NR==2{printf "  磁盘 %s   已用 %s，可用 %s\n", $1, $2, $3}' || true
  echo

  echo "最近检测（今日最后一条）"
  last_record || echo "  （暂无可显示的记录）"
}

cmd_log() {
  local n=100 follow=0 grep="" unit="$SAMPLER" label="采样器"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) n="${2:-}"; [[ -n "$n" ]] || die "-n 需要一个数字"; shift 2 ;;
      -f|--follow) follow=1; shift ;;
      -g|--grep) grep="${2:-}"; [[ -n "$grep" ]] || die "-g 需要一个关键词"; shift 2 ;;
      --console) unit="$CONSOLE"; label="控制台"; shift ;;
      *) die "log 未知参数：$1（用法：aiDetect log [-n 行数] [-f] [-g 关键词] [--console]）" ;;
    esac
  done
  [[ "$n" =~ ^[0-9]+$ ]] || die "-n 需要数字（当前：$n）"

  local -a args=(-u "$unit" -n "$n" --no-pager -o short-iso)
  if [[ $follow -eq 1 ]]; then
    args+=(-f)
  fi

  if [[ -n "$grep" ]]; then
    echo "== $label 日志（最近 $n 行内匹配 \"$grep\"）"
    journalctl "${args[@]}" | grep -- "$grep" || echo "（无匹配）"
  else
    if [[ $follow -eq 1 ]]; then
      echo "== $label 日志（最近 $n 行，跟踪中；Ctrl-C 退出）"
    else
      echo "== $label 日志（最近 $n 行）"
    fi
    journalctl "${args[@]}" || true
  fi
}

cmd_doctor() {
  [[ $# -eq 0 ]] || die "doctor 不接受参数"
  [[ -f "$ENV_FILE" ]] || die "找不到 $ENV_FILE"
  echo "跑 doctor 门禁（ffmpeg / AI 服务 / 时钟 / 视频源 / 磁盘）…"
  ( cd "$BASE" && set -a && . "$ENV_FILE" && set +a \
      && PYTHONPATH="$BASE/src" python3 -m m20_ai_detect doctor ) \
    || die "doctor 未全绿（见上方各项）"
}

usage() {
  # 非 quoted heredoc：正文里没有 $ 与反引号，可安全插值 $APP_ID/$HELPER/$BASE
  cat <<EOF
aiDetect —— $APP_ID 终端运维命令（当前身份 APP_ID=$APP_ID，BASE=$BASE）

用法：aiDetect <子命令> [参数]

  up                         启动控制台（网页 5050；**不启动采集**，ADR-010）
  down                       停止控制台
  restart                    重启控制台（改 env 后要重启采样器用 collect restart）
  collect on|off|status|restart
                             采集开关：控制采样器是否抽帧并调 AI（默认关闭）
  enable                     控制台开机自启：开启
  disable                    控制台开机自启：关闭（采集不设自启，重启后默认关闭）
  reset                      清空积压帧（spool/）：停采集仅当运行中，清完恢复原状态
  status                     状态总览（服务 / 采集 / 自启 / 版本 / 积压 / 磁盘 / 最近检测）
  log [-n 行数] [-f] [-g 关键词] [--console]
                             看运行日志（默认采样器；-f 跟踪、Ctrl-C 退出）
  doctor                     上线前门禁检查（ffmpeg/AI 服务/时钟/视频源/磁盘）
  help                       本帮助

示例：
  aiDetect status                巡检一眼看全
  aiDetect up                    机器人重启后：先起控制台网页
  aiDetect collect on            再按需开采集（或网页「采集开关」一键切换）
  aiDetect collect off           停采集（历史数据/时间轴/文件浏览不受影响）
  aiDetect reset                 积压太多：清空并以实时为准
  aiDetect log -g FAIL -n 300    在最近 300 行里找失败记录

说明：
  * 服务动作与自启开关经 sudoers 白名单（$HELPER）免密执行；
  * up/down/restart/enable/disable 只作用于**控制台**；采集（采样器）由 collect 或网页开关控制，
    默认关闭（ADR-010）——不再有 --all 参数；
  * reset 与网页「清理数据」勾 spool 等价：仅当采集在运行时 停采集 → 删 spool/*.jpg → 恢复启动；
    采集原本关着则只清不启（ADR-010/011）；只清未推理的待办帧，raw/ 与 results/ 不动。
EOF
}

# ---------------------------------------------------------------- 入口
CMD="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$CMD" in
  up|down|restart|reset|status|st|log|logs|doctor|enable|disable|collect)
    [[ -d "$BASE" ]] || die "工程目录不存在：$BASE（可用 M20AI_BASE_DIR 覆盖）"
    ;;
esac

case "$CMD" in
  up)              cmd_up "$@" ;;
  down)            cmd_down "$@" ;;
  restart)         cmd_restart "$@" ;;
  collect)         cmd_collect "$@" ;;
  enable)          cmd_autostart enable "$@" ;;
  disable)         cmd_autostart disable "$@" ;;
  reset)           cmd_reset "$@" ;;
  status|st)       cmd_status "$@" ;;
  log|logs)        cmd_log "$@" ;;
  doctor)          cmd_doctor "$@" ;;
  help|-h|--help)  usage ;;
  *)               usage >&2; echo "aiDetect: 未知子命令：$CMD" >&2; exit 2 ;;
esac
