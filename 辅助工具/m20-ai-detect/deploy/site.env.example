# ============================================================
# 部署前统一配置（site.env）—— **本文件在开发机上填，不必等代码上机**
#
# 用法：
#   cp deploy/site.env.example deploy/site.env      # 只需一次
#   vi deploy/site.env                              # 填目标机与关键参数
#   ./deploy/install.sh                             # 自动按本文件渲染远端配置
#
# 规则：
#   * 值留空 = 用模板默认（deploy/m20-ai-detect.env.example 里的值）
#   * DEPLOY_HOST / DEPLOY_DIR 也可被命令行覆盖：./deploy/install.sh user@1.2.3.4
#   * 远端**已有** m20-ai-detect.env 时默认不覆盖（保护现场）；要覆盖加 --with-env
#   * 本文件含内网地址，已在 .gitignore 中，不要提交
# ============================================================

# ---------- 部署身份（ADR-017；改名就改这一行）----------
# APP_ID 决定：systemd unit 名（<id>-ai-detect / <id>-ai-console）、
#   env 文件名（<BASE_DIR>/<id>-ai-detect.env）、helper 路径、sudoers 路径、
#   日志标识符、Web 控制台顶栏显示名。
# 字符集：字母/数字/下划线/连字符，≤32 位，必须以字母或数字开头。
# **留空 = 缺省 m20**（老部署零改动；此时渲染结果与改造前逐字相同）。
# 例：APP_ID=lite3
APP_ID=

# 平台展示名（可留空，留空则由 profile 兜底，见 deploy/profiles/）
# M20AI_PLATFORM_NAME=Lite3 · 单目

# ---------- 目标机 ----------
DEPLOY_HOST=user@192.168.0.196
DEPLOY_DIR=/home/djw/m20-ai-detect

# ---------- 采样器（写入远端 m20-ai-detect.env）----------
# AI 识别服务（默认用内置值；换服务/换模型时才改）
# M20AI_AI_BASE=http://jsxy.aihyzh.com:30881
# M20AI_CAP_ID=ai-04-yolov8-object-detection
# M20AI_PARAMS_JSON={"obj_thresh":0.3,"nms_thresh":0.45}

# 相机源：新机器务必改成**新机 AOS 的内网 IP**（默认 10.21.31.103 是本套的）
M20AI_SRC_F=rtsp://10.21.31.103:8554/video1
M20AI_SRC_B=rtsp://10.21.31.103:8554/video2
M20AI_ENABLE_F=1
M20AI_ENABLE_B=0

# 采集节奏与留存
M20AI_FPS=1
M20AI_SAVE_MODE=alert
M20AI_SPOOL_MAX_FILES=600

# 告警关注目标（逗号分隔，留空=不筛选）
# M20AI_ALERT_LABELS=person,car

# ---------- Web 控制台（写入远端 m20-ai-console.env）----------
M20AIC_PORT=5050
# 需要口令访问时填；留空=不鉴权（仅限内网）
# M20AIC_TOKEN=
