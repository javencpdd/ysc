# ============================================================
# profile: lite3-single —— Lite3 单目（云深处 Lite3，感知/导航主机）
#
# 用法见 m20pro-dual.env 顶部说明。只覆盖平台相关键，通用项不动。
#
# ⚠️ 下面的 IP / 路径是**示例**，务必按现场实际改：
#    Lite3 的双主机分工与本项目参考部署不同（120=网关/运动控制、103=感知导航），
#    摄像头推流地址以 robot 侧实际配置为准（相机是否走 8554/1935、路径名是什么）。
#    拿不准时先跑发现器（README §"视频源发现器"）：
#      PYTHONPATH=src python3 -m m20_ai_detect discover --scope auto
# ============================================================

M20AI_PROFILE=lite3-single
M20AI_PLATFORM_NAME=Lite3 · 单目

# ---------- 视频源 ----------
# 单目：只启用一路。第二路默认留成 |off 占位，将来加相机不用改语法。
# 示例用 rtsp+tcp（TCP 穿透 NAT/弱网更稳，代价是约 1 帧额外缓冲时延）；
# 内网直连且对时延敏感可换 rtsp+udp://（适配层会自动加 -rtsp_transport udp 语义）。
M20AI_SOURCES=main=rtsp+tcp://192.168.2.103:8554/live|fps=1;aux=rtsp+tcp://192.168.2.103:8554/live2|off

# ---------- 采集 ----------
# Lite3 算力比 M20 Pro 的 GOS 紧张，默认仍 1fps；单路更省，可酌情提到 2fps
# （每路每帧一次 HTTP 推理，AI 服务吞吐是上限，不是本机 CPU）
M20AI_FPS=1

# ---------- 时钟 ----------
# 无车队 PTP 主时钟，保持 0 = 启动时自动测量（实测会得到 ≈0，不影响 JSONL）。
M20AI_TS_OFFSET_SEC=0

# ---------- 本地视频设备 ----------
# Lite3 不跑厂商 restart.sh 时可打开（device:// 本地相机，如设备上的 USB 相机）。
# 打开后命令行才会展开 -f v4l2；保持 0 则配置里写 device:// 会直接报错并提示本开关。
M20AI_ALLOW_LOCAL_DEVICE=0
