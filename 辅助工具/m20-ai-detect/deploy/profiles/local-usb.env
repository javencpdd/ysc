# ============================================================
# profile: local-usb —— 本机直连相机（USB / V4L2 / MIPI）
#
# 用法见 m20pro-dual.env 顶部说明。适用于开发机、工控机、以及不跑厂商
# restart.sh 的机器人主机（Lite3 可用；**M20 Pro 参考部署不要用**，原因见下）。
#
# ⚠️ device:// 的两条硬约束（缺一不可）：
#   1. 必须显式打开 M20AI_ALLOW_LOCAL_DEVICE=1，否则配置校验直接报错；
#   2. 目标机不能跑会 ``pkill -f v4l2`` 的上游脚本（M20 的 restart.sh 就会）。
#      本项目的 Config.FORBIDDEN_TOKENS 守卫正是为此而设。
# 之所以用 device:///dev/video0 而不是在 src 里写 -f v4l2：
#   让禁词只在**适配层展开命令行的瞬间**出现，配置文件与日志里永不出现。
# ============================================================

M20AI_PROFILE=local-usb
M20AI_PLATFORM_NAME=本地相机

# ---------- 视频源 ----------
# device:// 写法：device:///dev/video0（三斜杠：scheme 后是空 authority + 绝对路径）
#   简写 device://  等价于 /dev/video0；device://1 等价于 /dev/video1
# 多相机就加分号：cam0=device:///dev/video0|fps=2;cam1=device:///dev/video2|fps=2
# ⚠️ 同一路 ffmpeg 独占 /dev/video*：别跟其它进程（如机器人自带的取图进程）抢。
#    先 ``ls -l /dev/video*`` 与 ``fuser -v /dev/video0`` 确认真没人占。
M20AI_SOURCES=cam0=device:///dev/video0|fps=2;cam1=device:///dev/video2|off

# ---------- 本地设备闸门 ----------
# 1 = 允许展开 v4l2 命令行。这就是"我知道目标机没有 pkill 误杀风险"的显式声明。
M20AI_ALLOW_LOCAL_DEVICE=1

# ---------- 采集 ----------
# USB 相机无网络抖动，2fps 也稳；MJPEG 相机建议更低（1fps）以免占满 USB 带宽
M20AI_FPS=2
M20AI_JPEG_Q=3
# 本地源没有"帧不新鲜"的问题，放宽新鲜度阈值减少无效重抽
M20AI_FRESH_AGE_SEC=1.5

# 有的 UVC 相机输出是 YUYV/MJPEG，需要额外参数时用 extra（逗号分隔的 ffmpeg 片段）：
# M20AI_SOURCES='cam0=device:///dev/video0|fps=2|extra=-input_format,mjpeg'
# 画面上下颠倒（相机装反了）用 extra=-vf,vflip

# ---------- 时钟 ----------
M20AI_TS_OFFSET_SEC=0
