# ============================================================
# profile: m20pro-dual —— M20 Pro 双目（参考部署，GOS 10.21.31.104）
#
# 这是什么：一组"平台差异项"，不是完整配置。
# 用法（二选一）：
#   a) 追加：cp m20-ai-detect.env.example <app>-ai-detect.env
#      cat deploy/profiles/m20pro-dual.env >> <app>-ai-detect.env
#      （同名键以本文件为准，因为 env 后写覆盖先写）
#   b) 手抄：把下面非注释行并进 <app>-ai-detect.env 对应段
#
# 只放**平台相关**的键（视频源 / 传输 / 时钟 / 本地设备闸门）；
# AI 服务地址、留存策略、告警清单等通用项留在基础 env 里，改 profile 不会丢。
# ============================================================

# 展示名：Web 控制台顶栏与日志里给人看的名字。
# 留空则由 M20AI_PROFILE 兜底映射（见 src/m20_ai_detect/identity.py PROFILE_TITLES）。
M20AI_PROFILE=m20pro-dual
M20AI_PLATFORM_NAME=M20 Pro · 双目

# ---------- 视频源（ADR-016 新语法）----------
# 语法：name=uri[|opt=v]，源之间用 **分号** 分隔（URL 里可能含逗号，不能用逗号分隔）。
#   选项白名单：off（停用但保留配置）/ fps / transport / extra / note
# scheme 即类型：rtsp / rtsp+tcp / rtsp+udp / rtmp / http(s) / device / file / onvif / 无 scheme=raw
# 本参考部署：前视来自 AOS 10.21.31.103 的 MediaMTX（8554），后视默认停用。
#   换到新 M20 时把 IP 改成新机 AOS 的内网地址。
M20AI_SOURCES=front=rtsp+tcp://10.21.31.103:8554/video1;back=rtsp+tcp://10.21.31.103:8554/video2|off

# ---------- 采集 ----------
# 前视 1fps 足够做抽帧检测；后视若启用可单独降帧（在 SOURCES 里加 |fps=0.5）
M20AI_FPS=1

# ---------- 时钟（ADR-004）----------
# M20 车队 PTP 主时钟把系统时间钉在 2024-06-20 且持续拖回，不跟车队较劲：
# 0 = 启动时向 AI 服务 Date 头自动测量偏移，JSONL 的 ts 修正为真实时间。
# 换到没有 PTP 主时钟的平台（Lite3 / IPC）也保持 0，自动测量会自动得到 ≈0。
M20AI_TS_OFFSET_SEC=0

# ---------- 本地视频设备 ----------
# M20 Pro 跑厂商 restart.sh（会 pkill -f 含 v4l2 的命令行），故**不要**在本平台
# 启用 device:// 本地相机：即便本开关打开，命令行里出现的 -f v4l2 仍有被误杀的风险。
M20AI_ALLOW_LOCAL_DEVICE=0
