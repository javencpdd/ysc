# ============================================================
# profile: ipc-generic —— 通用网络相机 / NVR（IPC · ONVIF）
#
# 用法见 m20pro-dual.env 顶部说明。面向"固定机位、只读一路 RTSP"的第三方设备：
# 海康/大华/NVR、go2rtc/MediaMTX 转发出来的 downstream 流都可以。
#
# 与机器人平台 profile 的差别：没有 PTP 时钟问题、没有厂商 restart.sh 误杀风险，
# 但有 **认证** 与 **码流选择** 两件麻烦事，见下方说明。
# ============================================================

M20AI_PROFILE=ipc-generic
M20AI_PLATFORM_NAME=IPC · ONVIF

# ---------- 视频源 ----------
# 主/子码流：同一台相机通常有 1080p 主码流与 640p 子码流两条 RTSP。
# 抽帧检测用**子码流**就够（1~2fps，YOLO 输入侧还会再缩放），能省 4 倍带宽。
# 路径名各家不同，常见 rtsp://ip:554/Streaming/Channels/102（海康子码流）、
# /live/ch2、/cam/realmonitor?channel=1&subtype=1 等——以相机文档为准，
# 或先跑发现器让本机穷举候选路径：
#   PYTHONPATH=src python3 -m m20_ai_detect discover --scope host:192.168.1.64
M20AI_SOURCES=main=rtsp+tcp://192.168.1.64:554/Streaming/Channels/102|fps=1;sub=rtsp+tcp://192.168.1.64:554/Streaming/Channels/101|off

# 需要认证时把凭据写进 URL（systemd EnvironmentFile 会做引号剥除，
# 含 / @ : 的密码建议整行用单引号包起来，见 m20-ai-detect.env.example 的 PARAMS_JSON 说明）：
# M20AI_SOURCES='main=rtsp+tcp://admin:password@192.168.1.64:554/Streaming/Channels/102|fps=1'

# ---------- 传输 ----------
# 跨网段/无线一律 rtsp+tcp（上面默认已是）；纯有线内网且在意时延可换 rtsp+udp://。
# 走 HTTP(MJPEG) 的老相机直接用 http://ip/mjpg/video.mjpg，适配层会自动加 -f mjpeg。
# 上游是 go2rtc/MediaMTX 时用 rtmp:// 也可（适配层加 -f flv）。

# ---------- 采集 ----------
# 固定机位没有"新鲜度"概念，可放宽到 2s，减少因网络抖动造成的重复抽帧
M20AI_FRESH_AGE_SEC=2.0

# ---------- 本地设备 ----------
M20AI_ALLOW_LOCAL_DEVICE=0
