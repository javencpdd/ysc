#!/usr/bin/env bash
# ============================================================================
# rtmp_1012 配置文件
# 修改后需重启服务生效:  sudo ./stop.sh && sudo ./start.sh
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 源：本机 MediaMTX 提供的 RTSP 流
#    由 /opt/robot/scripts/board_resources/rtsp_service/push_video.sh 推入
#    video1 = 挂在 usb2/2-1 的相机 (原 /dev/video0)
#    video2 = 挂在 usb7/7-1 的相机 (原 /dev/video2)
# ---------------------------------------------------------------------------
STREAM_F_SRC="rtsp://127.0.0.1:8554/video1"     # 前视
STREAM_B_SRC="rtsp://127.0.0.1:8554/video2"     # 后视

# ---------------------------------------------------------------------------
# 2. 目标：外部 RTMP 服务器
# ---------------------------------------------------------------------------
RTMP_BASE="rtmp://172.31.68.227:1936/live"
STREAM_F_DST="${RTMP_BASE}/m20pro-f"
STREAM_B_DST="${RTMP_BASE}/m20pro-b"

# ---------------------------------------------------------------------------
# 3. 源编码 —— 决定是否需要转码
#    h265 : 源是 H.265/HEVC。RTMP(FLV) 在 GStreamer 1.16 下不支持 HEVC，
#           必须走 mppvideodec 硬解 + mpph264enc 硬编（实测 ~10-15% 单核/路）
#    h264 : 源是 H.264。纯 remux 直推，几乎零 CPU、延迟最低（同 120 主机方案）
#    ⚠ 若上游把关机改推 H.264 (push_video.sh 里 mpph265enc -> mpph264enc)，
#      把这里改成 h264 可获得最佳性能。
# ---------------------------------------------------------------------------
SOURCE_CODEC="h264"

# ---------------------------------------------------------------------------
# 4. 编码参数（仅 SOURCE_CODEC=h265 时生效）
# ---------------------------------------------------------------------------
RC_MODE=1            # 1=CBR, 0=VBR
BPS=2000000          # 目标码率 2 Mbps
BPS_MAX=2500000      # 峰值码率
GOP=30               # 关键帧间隔 (30 = 1s @30fps)
QP_MIN=12            # 最小 QP（限制最高画质，防码率失控）
QP_MAX=45            # 最大 QP（限制最低画质，防糊成一片）

# 送进 mpph264enc 的原始色度格式
#   ⚠ 必须是 I420 或 YV12，绝对不要设成 NV12！
#     实测：mpph264enc 在 NV12 输入下会输出严重花屏（绿紫横向条纹，
#     行步长错位），无论 NV12 是 videoconvert 产生的还是 mppvideodec
#     直接输出的都会坏；换 I420 后画面完全正常。
#     （mppvideodec 硬解本身没问题——它解码后转 RGB 出图是干净的。）
PIX_FMT=I420

# ---------------------------------------------------------------------------
# 4b. 外推转码降压（TRANSCODE=true 时生效，SOURCE_CODEC=h264 模式下可选）
#
#     背景（2026-10-18 诊断）：M20 唯一出口为 p2p0 WiFi（连 Tenda 5G，
#     实测信号 -60dBm、ping 服务器 RTT mdev 12.4ms/max 74.9ms；同位置
#     PC 对照 max 11ms）。纯 remux 把相机源码率（目标 2Mbps、实测
#     ~2.4Mbps/路，双路 4.83Mbps）原样搬上该链路，TCP 反复重传退避
#     （实测 rto 54s / cwnd 1），RTMP 播出端周期性卡顿。本地 RTSP/HLS
#     走 127.0.0.1 回环，故完全不受影响——这解释"本地不卡、服务器端卡"。
#
#     2026-10-19 01:2x 决策：链路已恢复（wifi-uplink-check.sh 实测 mdev 2.6ms、
#     0% 丢包、双路 cwnd≥97），转码降压的紧迫性消失，而其延迟代价显著——
#     对比 Lite3（同款 RK3588、720p 源）纯 remux 端到端 ~100-150ms，M20
#     转码管线估算 300-600ms：videorate 抽帧(33→66ms) + videoconvert
#     软件转换单核 99.5%（两路 relay 实测 93-94%/核，queue 默认 1s 缓冲
#     堆积是主因）+ mpph264enc B 帧缓冲 + GOP=15@15fps=1.0s 关键帧间隔。
#     ⇒ 默认关闭，延迟/CPU/画质全面回归源流水平。
#
#     何时需要再打开：wifi-uplink-check.sh -q 退出码 2（CRIT：丢包≥5% /
#     RTT mdev>15ms / rto>1s / cwnd<30）持续出现，播出端卡顿复现时。
#     备份：config.env.bak-transcode-off-20261019-012425（转码参数原样）。
# ---------------------------------------------------------------------------
TRANSCODE=false
RELAY_BPS=1200000      # 外推目标码率。800x600 监控画面 1.2M 足够
RELAY_BPS_MAX=1500000  # 外推峰值码率
RELAY_FPS=15           # 外推帧率（源 30fps 减半，码率/延迟同步下降）
RELAY_GOP=15           # 关键帧间隔。⚠ 15fps 下 = 1.0s（不是 0.5s，那是按 30fps 误算的）；
                       #   若想 0.5s 一个关键帧，15fps 下应设为 8。当前链路已恢复，
                       #   转码非必需，见 §4b 说明与 README §11。
RELAY_QP_MIN=24        # 允许复杂场景降质保码率（相机侧 qp-min=12 是超配主因）
RELAY_QP_MAX=45        # 最低画质下限（与相机侧一致）

# ---------------------------------------------------------------------------
# 5. CPU 亲和
#    相机采集管道占 4,5 和 6,7，转发器避开它们
#    机器共 8 核 (nproc --all)，但默认 shell 限制在 0-3
# ---------------------------------------------------------------------------
CPU_F="0,1"
CPU_B="2,3"

# ---------------------------------------------------------------------------
# 6. 传输
#    LATENCY: 源在 loopback 上，抖动极小，不需要大缓冲
#    ⚠ 管道中刻意不使用 drop-on-latency / queue leaky —— 实测这些东西
#      在源流中断时会让管线陷入 CRITICAL 报错风暴并把 CPU 打到 73%。
#      转码中继必须保持帧序完整，不能丢。
# ---------------------------------------------------------------------------
LATENCY=50               # rtspsrc 抖动缓冲(ms)，2026-10-14 由 100 降为 50（TCP interleaved + 链路实测 0% 丢包）

# ---------------------------------------------------------------------------
# 7. 重连与看门狗
#    rtmpsink 在远端断开后不会让 gst 退出（进程看似存活实则已停推），
#    所以需要一个看门狗主动发现并重启管道。
# ---------------------------------------------------------------------------
RETRY_SECONDS=5              # 管道退出后的重连间隔
MAX_CONNECT_FAILURES=3       # 目标网络连续 N 次探测失败 => 停推（退出码 3）
PROBE_TIMEOUT=5              # 单次目标 TCP 探测超时
NETWORK_BACKOFF_MAX=60       # 目标网络不可达时的退避上限

WATCHDOG_INTERVAL=5          # 看门狗检查周期(秒)
WATCHDOG_STRIKES=2           # 连续 N 次判为异常则重启管道
WATCHDOG_GRACE=25            # 启动宽限期(秒)：期间容忍"连接尚未建立"
STALL_SENDQ=1000000          # 目标 socket 发送队列超过此字节数视为积压(约 1MB)

# ---------------------------------------------------------------------------
# 8. 与上游相机服务的隔离（重要）
#
#    机器人的应用管理守护进程 basic_server 会在相机流异常时调用
#    /opt/robot/scripts/board_resources/rtsp_service/restart.sh，
#    而该脚本里有：
#        pids=$(pgrep -f "gst-launch"); kill -9 $pids
#    —— 它按名字无差别杀系统里所有 gst-launch 进程，会把本转发器的
#       gst 管道一起杀掉（表现为推流每几分钟断一次）。
#
#    对策：把 gst-launch-1.0 复制成另一个名字再调用，argv[0] 不含
#    "gst-launch"，上游的 pkill 就匹配不到我们。
#    start.sh 会在启动时自动创建这个副本。
# ---------------------------------------------------------------------------
GST_BIN="/home/user/rtmp_1012/bin/rtmp-gst"
GST_FALLBACK="/usr/bin/gst-launch-1.0"

# ---------------------------------------------------------------------------
# 8. 源流健康探测
#    源由本机 mediamtx 提供；只看 RTSP 端口没意义（mediamtx 一直在），
#    所以用它的 HLS 端点判断"推流端是否还活着"。
#    源断时跳过启动 gst，避免无谓的报错刷屏。
# ---------------------------------------------------------------------------
CHECK_SOURCE=true
SOURCE_HEALTH_BASE="http://127.0.0.1:8888"
SOURCE_PROBE_TIMEOUT=4

# ---------------------------------------------------------------------------
# 9. 日志
# ---------------------------------------------------------------------------
LOG_MAX_BYTES=5242880        # 单文件 5MB 后自动轮转

# ===========================================================================
# 日志轮转配置（由 lib/m20-log.sh + /usr/local/sbin/m20-log-rotate.sh 提供）
#
#   机制：单个日志文件达到上限即自动切分；只保留最近 N 份历史；超出的删最旧的；
#         切换过程不丢日志、不中断写入（copytruncate，兼容 gst-launch 长期
#         持有 fd 直接写日志的方式）；多进程并发下用 flock 串行化，安全。
#
#   旧的 LOG_MAX_BYTES 仍兼容（优先级低于 M20LOG_MAX_BYTES），
#   若未设置 M20LOG_MAX_BYTES 则回退到 LOG_MAX_BYTES。
# ===========================================================================
M20LOG_MAX_BYTES=10485760     # 单文件大小上限(字节)。默认 10485760 = 10MB。
                              #   达到即切分，新建/清空后继续写入
M20LOG_KEEP=5                 # 保留最近几份历史文件(不含当前正在写的)。默认 5。
                              #   超出的从最旧开始删除
M20LOG_TOTAL_MAX_BYTES=0      # 单路日志「总占用」硬上限(字节)。默认 0 = 不额外限制，
                              #   此时隐含上限 = MAX_BYTES * (KEEP+1) = 10MB*6 = 60MB。
                              #   若想绝对固定占用（例如磁盘小），设为具体值，如 52428800(50MB)
M20LOG_DIR=                   # 历史文件存放目录。留空 = 与日志文件同目录(推荐)
M20LOG_NAME_FMT=seq           # 轮转文件命名格式：
                              #   seq → forward-f.1.log / forward-f.2.log ...
                              #   ts  → forward-f-20261016-030900.log（时间戳）
                              #   也支持自定义模板，占位符 {base} {ext} {n} {ts}
M20LOG_MODE=copytruncate      # 轮转方式。默认 copytruncate：复制后截断，fd 不变、
                              #   写入不中断 —— 必须用它，因为 gst 长期持有 fd。
                              #   mv 是原子改名(零丢失)，但会让 gst 继续写进旧文件
M20LOG_TS_FMT=%Y%m%d-%H%M%S   # {ts} 占位符的时间格式
M20LOG_CHECK_BYTES=4096       # 写入方累积写入多少字节做一次大小检查(主触发条件)
M20LOG_MIN_CHECK_INTERVAL=1   # 低频日志的最小检查间隔(秒)
M20LOG_CATCHUP_ROUNDS=4       # copytruncate 的追赶复制轮数，用于压缩丢失窗口
M20LOG_LOCK_WAIT=0            # 抢锁等待秒数。0 = 非阻塞（推荐，避免竞争进程被阻塞后
                              #   正好撞上截断而多丢日志）
M20LOG_SCAN_DIR=/home/user/rtmp_1012/logs   # 巡检脚本扫描的目录
M20LOG_SCAN_GLOB=*.log        # 巡检脚本匹配的文件名模式
